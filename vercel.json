{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd econexao-app && npm install && npm run export:web",
  "outputDirectory": "econexao-app/dist",
  "rewrites": [
    {
      "source": "/((?!api/|_expo/|assets/|favicon.ico|metadata.json).*)",
      "destination": "/index.html"
    }
  ]
}
