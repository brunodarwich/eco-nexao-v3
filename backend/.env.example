# Configurações do Aplicativo Backend ECOnexão
APP_ENV=development
APP_NAME="ECOnexão API"
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:3000","exp://localhost:8081","https://eco-nexao-v3.vercel.app","https://eco-nexao-v3-git-staging-bruno-darwichs-projects.vercel.app","https://econexao.app","https://staging.econexao.app"]
LOG_LEVEL=INFO
DATABASE_ECHO=false
ROUTE_CORRIDOR_BUFFER_METERS=1000
STATIC_MAP_MAX_PINS=200

# Supabase e PostgreSQL (somente backend)
# Use a conexão do ambiente atual. Nunca reutilize production em development/test.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Opcional até existir uma operação administrativa. Prefira sb_secret_ a service_role legado.
SUPABASE_SECRET_KEY=
# Opcional; quando vazio, o backend deriva de SUPABASE_URL.
SUPABASE_JWKS_URL=
# O backend valida estes claims em todos os JWTs Supabase recebidos.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Conectores Externos e Roteamento Dinâmico
GOOGLE_PLACES_API_KEY=
# fake_deterministic é permitido somente em development/test. Staging usa google_routes.
ROUTING_PROVIDER=fake_deterministic
ENABLE_DYNAMIC_ROUTING=false
DYNAMIC_ROUTING_RATE_LIMIT_PER_MINUTE=10
# Segredo server-side; configure no secret manager do ambiente, nunca no Expo/Git.
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_TIMEOUT_SECONDS=3.5
GOOGLE_ROUTES_MAX_RETRIES=2
GOOGLE_ROUTES_MONTHLY_ALERT_AT=7500
GOOGLE_ROUTES_MONTHLY_LIMIT=9000
# Cache de respostas Google permanece desabilitado até homologação jurídica específica.
SENTRY_DSN=
